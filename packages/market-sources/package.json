{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/market-sources",
  "version": "0.1.0",
  "description": "The adapters of the sellers of a market: each one reads the answer of an official API, and gives the current offers and price readings as records of @mark1russell7/market.",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@mark1russell7/market": "workspace:*",
    "@mark1russell7/quantity": "^0.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
