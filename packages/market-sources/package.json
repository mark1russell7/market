{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/market-sources",
  "version": "0.5.1",
  "description": "The adapters of the sellers of a market and of cloud price APIs: each one reads the answer of an official API, and gives the current offers and price readings as records of @mark1russell7/market.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/market.git",
    "directory": "packages/market-sources"
  },
  "homepage": "https://github.com/mark1russell7/market/tree/main/packages/market-sources#readme",
  "bugs": {
    "url": "https://github.com/mark1russell7/market/issues"
  },
  "keywords": [
    "market",
    "prices",
    "offers",
    "seller-api",
    "adapters",
    "price-history",
    "polite-crawler",
    "cloud-pricing",
    "azure"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@mark1russell7/market": "workspace:*",
    "@mark1russell7/quantity": "^0.4.8",
    "@mark1russell7/text": "^0.0.16",
    "polite-crawler": "^0.7.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "fast-check": "^4.10.2",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "import": "./build/index.js",
        "default": "./build/index.js"
      },
      "./package.json": "./package.json"
    }
  }
}
