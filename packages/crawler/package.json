{
  "$schema": "https://json.schemastore.org/package",
  "name": "@market/crawler",
  "version": "0.1.0",
  "description": "The crawler of the market: the transport, the keys and the live read command of the clients of @mark1russell7/market-sources.",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "read": "node src/bin.ts read",
